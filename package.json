{
  "name": "kmusic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/src/index.ts\" \"vite --config web/vite.config.ts\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "0.6.0",
    "@applemusic-like-lyrics/lyric": "1.1.0",
    "@applemusic-like-lyrics/ttml": "1.0.1",
    "@applemusic-like-lyrics/vue": "0.6.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "iconv-lite": "0.7.3",
    "lucide-vue-next": "^0.544.0",
    "opencc-js": "1.4.2",
    "pinia": "^3.0.3",
    "qishui-music-api": "0.2.2",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
