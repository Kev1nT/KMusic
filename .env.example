# ===== 必填 =====
# 管理后台密码（首次部署后登录用）
ADMIN_PASSWORD=change-me

# ===== 常用 =====
# 宿主机音乐目录（Emby / Jellyfin / Navidrome 指向这里）
MUSIC_HOST_DIR=./music
# 对外端口
KMUSIC_PORT=8090
# 容器内运行用户，需与音乐目录属主一致
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# ===== 镜像 =====
# 使用 Docker Hub 镜像（默认）或改为本地构建：docker compose build
KMUSIC_IMAGE=kev1nt/kmusic:latest

# ===== Apple Music（可选）=====
# wrapper 首次启动会用该 Apple ID 登录并缓存会话；不填则 Apple 功能不可用
APPLE_ID=
APPLE_PASSWORD=
